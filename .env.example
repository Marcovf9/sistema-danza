# ── Copiar a .env y completar los valores ─────────────────────────────────────
# cp .env.example .env

# ── Base de datos (local con Docker MySQL) ─────────────────────────────────────
DB_USER=admin
DB_PASSWORD=CAMBIAR_EN_PRODUCCION
DB_NAME=academia_danza

# ── Base de datos (TiDB Cloud — para producción) ──────────────────────────────
# Pegar el connection string del dashboard de TiDB Cloud:
# SPRING_DATASOURCE_URL=jdbc:mysql://<gateway>:<port>/<db>?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
# SPRING_DATASOURCE_USERNAME=<tidb_user>
# SPRING_DATASOURCE_PASSWORD=<tidb_password>

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=GENERAR_CLAVE_ALEATORIA_LARGA_AQUI

# ── Gmail App Password ─────────────────────────────────────────────────────────
# Obtener en: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=tu_app_password_de_gmail

# ── URLs ───────────────────────────────────────────────────────────────────────
# URL pública del frontend (para links en emails de recuperación de contraseña)
APP_FRONTEND_URL=https://tu-sitio.netlify.app

# ── CORS ───────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma (producción = tu dominio Netlify)
CORS_ALLOWED_ORIGINS=https://tu-sitio.netlify.app
